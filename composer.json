{
    "name": "alifcoder/activity-log",
    "description": "A simple action activity log package for Laravel.",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Alif\\ActivityLog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alif\\ActivityLog\\ActivityLogServiceProvider"
            ],
            "aliases": {
                "ActivityLogger": "Alif\\ActivityLog\\Facades\\ActivityLogger"
            }
        }
    },
    "authors": [
        {
            "name": "Shukhratjon Yuldashev",
            "email": "uzalifcoder@gmail.com"
        }
    ],
    "require-dev": {
        "laravel/framework": "^13.0",
        "laravel/pint": "^1.29",
        "phpstan/phpstan": "^2.1",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0"
    },
    "scripts": {
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "@php vendor/bin/pint",
        "format:test": "@php vendor/bin/pint --test"
    }
}
