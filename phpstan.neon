includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - src

    # Level 10 is the highest level
    level: 5

    universalObjectCratesClasses:
        - Illuminate\Http\Resources\Json\JsonResource

    ignoreErrors:
        # Public trait for host models: the package itself never uses it, so it is never "used" in src
        - identifier: trait.unused
          path: src/Traits/ActivityLogTrait.php
