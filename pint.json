{
  "preset": "laravel",
  "exclude": [
    "vendor"
  ],
  "rules": {
    "ordered_traits": false,
    "array_syntax": {
      "syntax": "short"
    },
    "concat_space": {
      "spacing": "one"
    },
    "no_unused_imports": true,
    "ordered_imports": {
      "sort_algorithm": "alpha"
    },
    "single_quote": true,
    "trailing_comma_in_multiline": {
      "elements": [
        "arrays",
        "arguments",
        "parameters"
      ]
    }
  }
}
